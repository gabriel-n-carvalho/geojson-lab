# --- Server-side (used by api/mapkit-token.ts) ---
# These are NEVER prefixed with VITE_ and must never reach the client bundle.

# From Apple Developer → Membership.
MAPKIT_TEAM_ID=

# Key ID of the MapKit JS key created in Apple Developer → Keys.
MAPKIT_KEY_ID=

# Full contents of the downloaded AuthKey_XXXX.p8 file. Either paste the raw
# PEM (newlines preserved — works in Vercel UI), or "\n"-escape it for CLI use.
MAPKIT_PRIVATE_KEY=

# Optional but strongly recommended in production. If set, JWTs include an
# "origin" claim restricting them to this origin (e.g. https://your-domain.com).
# Without it, MapKit JS logs a warning about unrestricted tokens.
MAPKIT_ORIGIN=

# Optional comma-separated allowlist for the Origin request header on the token
# endpoint (e.g. "https://geojson-lab.example.com,https://staging.geojson-lab.example.com"). Unset = allow all.
ALLOWED_ORIGINS=

# --- Client-side ---

# Optional. Where the SPA fetches its JWT from. Defaults to "/api/mapkit-token".
VITE_MAPKIT_TOKEN_ENDPOINT=
